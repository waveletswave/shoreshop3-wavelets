# ---- Data never goes into git -------------------------------------------------
# data/ is a local mirror of the ShoreShop3 Globus collection. It is large, and
# the UserSubmissions of other teams may not be public yet. Only the folder
# skeleton (.gitkeep) and data/README.md are tracked.
data/*/*
!data/*/.gitkeep
!data/README.md

# Figures and tables are regenerated by the code (force-add a final figure with git add -f).
outputs/*
!outputs/.gitkeep

# Belt and braces: common data formats anywhere in the repo
*.nc
*.nc4
*.mat
*.h5
*.hdf5
*.zarr/
*.zip
*.tar.gz

# Local configuration
config/globus.env

# Python / tooling
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# OS / editors
.DS_Store
.vscode/
.idea/
