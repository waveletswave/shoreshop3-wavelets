# Copy to config/globus.env (git-ignored) and edit if needed:
#   cp config/globus.env.example config/globus.env
# This file is read by bash: plain KEY=value lines only.

# ShoreShop3 Globus guest collection ("Guest collection of /rt.attic.346.shoreshop3").
# Treat it as READ-ONLY: never rename, delete or upload anything there.
SHORESHOP3_COLLECTION=5d24db1e-b934-4e35-9085-513be554aaa7

# Top-level folders to list / mirror (space separated).
SHORESHOP3_FOLDERS="InputData SubmissionTemplates PublicSubmissions UserSubmissions"

# Destination collection for scripts/globus_sync.sh.
# Empty = this computer's Globus Connect Personal endpoint (found automatically).
# For the Duke cluster, put that collection's ID here instead.
DEST_COLLECTION=

# Destination folder, as a Globus path. Empty = this repo's data/raw, written as
# "~/<path from your home folder>/data/raw" (how Globus Connect Personal sees it).
# Example for a cluster: DEST_ROOT=/work/<netid>/shoreshop3/raw
DEST_ROOT=

# How deep scripts/globus_manifest.sh descends into sub-folders.
MANIFEST_DEPTH=20
